table document_impact
	lineageTag: 188e6c8c-1228-4f7c-92b9-eefb38e40b72

	measure Publications = DISTINCTCOUNT('document_impact'[dimensions_id])
		formatString: #,0
		lineageTag: 4d17da97-629e-4bf7-a95c-a42888e38e47

	measure 'Publications With Known Citation Count' = COUNT('document_impact'[Resolved Total Citations])
		formatString: #,0
		lineageTag: 40506160-e0e4-4daa-8ad3-f532915a808b

	measure 'Cited Publications' = CALCULATE([Publications], KEEPFILTERS('document_impact'[Resolved Total Citations] > 0))
		formatString: #,0
		lineageTag: 37342b67-b43c-4b05-ab1f-e0950c41497c

	measure 'Uncited Publications' = CALCULATE([Publications], KEEPFILTERS('document_impact'[Resolved Total Citations] = 0), KEEPFILTERS(NOT ISBLANK('document_impact'[Resolved Total Citations])))
		formatString: #,0
		lineageTag: 55cc2eb2-dde0-4501-b4c2-61c84190517b

	measure 'Publications With Missing Citation Count' = [Publications] - [Publications With Known Citation Count]
		formatString: #,0
		lineageTag: 53ff4e39-8894-430b-9255-0d3e6c49cdd5

	measure '% Cited' = IF([Publications With Missing Citation Count] = 0, DIVIDE([Cited Publications], [Publications]))
		formatString: 0%
		lineageTag: 2821c319-9458-4b2e-879c-f7bc922d1367

	measure 'Total Citations' = SUM('document_impact'[Resolved Total Citations])
		formatString: #,0
		lineageTag: df64f13e-a124-47f8-b9d1-2e97edb1c2f5

	measure 'Average Citations per Publication' = IF([Publications With Missing Citation Count] = 0, DIVIDE([Total Citations], [Publications]))
		formatString: 0.00
		lineageTag: 31dc7333-0a57-4ca0-a464-827448a1ce7a

	measure 'Recent Citations' = IF(COUNT('document_impact'[Resolved Recent Citations]) = 0, BLANK(), SUM('document_impact'[Resolved Recent Citations]))
		formatString: #,0
		lineageTag: 8e01a8d8-6425-4674-9ab1-3c60c95eb76f

	measure 'Recent Citation Share' = IF([Publications With Missing Citation Count] = 0 && COUNT('document_impact'[Resolved Recent Citations]) = [Publications], DIVIDE([Recent Citations], [Total Citations]))
		formatString: 0%
		lineageTag: 7d2e6025-446a-4899-969a-4cd7fcd6a53d

	measure 'Cited Publications Subtitle' =
			IF(
				[Publications With Missing Citation Count] > 0,
				FORMAT([Publications With Missing Citation Count], "#,0") & " citation counts missing",
				"of " & FORMAT([Publications], "#,0") & " publications"
			)
		lineageTag: 67cf18e9-a59f-4e12-b793-4c1e5b4cbdcc

	measure '% Cited Subtitle' =
			IF(
				[Publications With Missing Citation Count] > 0,
				FORMAT([Publications With Missing Citation Count], "#,0") & " citation counts missing",
				FORMAT([Uncited Publications], "#,0") & " publications uncited"
			)
		lineageTag: fc543dce-492f-4ef5-8456-d09e24fc97ed

	measure 'Total Citations Subtitle' =
			IF(
				[Publications With Missing Citation Count] > 0,
				FORMAT([Publications With Missing Citation Count], "#,0") & " citation counts missing",
				"average " & FORMAT([Average Citations per Publication], "#,0") & " per publication"
			)
		lineageTag: 811d0a70-f607-447f-93c5-8ec12e9247e0

	measure 'Recent Citations Display' = IF(ISBLANK([Recent Citations]), "—", FORMAT([Recent Citations], "#,0"))
		lineageTag: e4a2e2cf-e8f1-42d0-a0aa-65a5ea128bbd

	measure 'Recent Citations Subtitle' = IF(ISBLANK([Recent Citations]), "Recent citation data unavailable", FORMAT([Recent Citation Share], "0%") & " of total citations")
		lineageTag: 9d0698a5-e822-4253-aefd-814860623f19

	measure 'Citation Data Coverage' = FORMAT([Publications With Known Citation Count], "#,0") & " of " & FORMAT([Publications], "#,0") & " publications have a known citation count"
		lineageTag: 1bb1c3b5-6c44-4a49-b208-0a8531068d45

	measure 'Recent Data Unavailable Title' = IF(ISBLANK([Recent Citations]), "Recent citation data unavailable", BLANK())
		lineageTag: 941ec388-ac32-46c8-a52c-f473a52cc38c

	measure 'Recent Data Unavailable Detail' = IF(ISBLANK([Recent Citations]), "Populate a verified recent-citations source to display this chart.", BLANK())
		lineageTag: 0b1c74db-535f-4f2f-9081-3577a5e600aa

